generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  APPLICANT
  REVIEWER
  ADMIN
}

enum ReviewSection {
  GUARANTOR
  APPLICATION_INFO
  ACADEMIC
  SCHOOL
  ESSAY
  SOCIAL
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_FIX
  APPROVED
  REJECTED
}

enum DecisionResult {
  APPROVED
  REJECTED
  WAITLISTED
}

enum Gender {
  MALE
  FEMALE
}

/// Анкетын 1.12 «Зорилтот бүлгийн хэлбэр». Нэг хүн нэгээс олонд хамаарч болно.
enum TargetGroupType {
  /// Бүтэн өнчин
  ORPHAN
  /// Хөгжлийн бэрхшээлтэй
  DISABILITY
  /// Төлбөрийн чадваргүй
  LOW_INCOME
  /// Онцгой амжилт гаргасан
  OUTSTANDING
  /// Бусад
  OTHER
}

/// Шалгуурын оноог анкетын тоон утгаас автоматаар санал болгох эх сурвалж.
enum AutoScoreSource {
  NONE
  EXAM_SCORE
  GPA
  UNIVERSITY_GPA
}

/// Тэтгэлгийн төрөл. Төрөл тус бүр өөрийн материал, шалгуур, квоттой.
enum CallTrack {
  /// Ерөнхий боловсролын сургууль төгсөгч
  GRADUATE
  /// Их, дээд сургуульд суралцаж буй оюутан
  STUDENT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  name             String
  phone            String?
  organization     String?
  jobTitle         String?
  role             Role            @default(APPLICANT)
  assignedSections ReviewSection[] @default([])
  /// Ажлын хэсгээс хасагдсан гишүүнийг устгахгүй, эрхийг нь ч бууруулахгүй —
  /// зөвхөн идэвхгүй болгоно. Ингэснээр өгсөн үнэлгээ, шийдвэрийн түүх бүтэн
  /// үлдэж, тухайн хүн системд нэвтэрч чадахгүй болно.
  isActive         Boolean         @default(true)
  emailVerifiedAt  DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  applications Application[]
  evaluations  CriterionEvaluation[]
  decisions    Decision[]          @relation("DecidedBy")
  auditLogs    AuditLog[]
  sessions     Session[]
  tokens       VerificationToken[]
}

/// Нэвтрэлтийн session. Cookie доторх түүхий токеныг хадгалахгүй — зөвхөн
/// SHA-256 хэшийг. DB задарсан ч session хулгайлагдахгүй.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Нэг жилийн тэтгэлгийн урилга. Шалгуур, хугацаа, тоо хэмжээ энд тодорхойлогдоно.
model ScholarshipCall {
  id               String    @id @default(cuid())
  name             String
  track            CallTrack @default(GRADUATE)
  year             Int
  /// «2026-2027 хичээлийн жил» гэх мэт харагдах бичиглэл.
  academicYear     String?
  description      String?
  opensAt          DateTime
  closesAt         DateTime
  quota            Int
  isActive         Boolean   @default(false)
  minExamScore     Int?
  minGpa           Float?
  /// Оюутны тэтгэлэгт: их сургуулийн голч (4.0 систем) доод хязгаар.
  minUniversityGpa Float?
  requiredAimag    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  requirements DocumentRequirement[]
  criteria     ScoringCriterion[]
  applications Application[]

  @@unique([year, name])
}

/// Журмын шалгуур үзүүлэлт. Нийт оноо 100 болохоор тохируулагдана.
/// Хүснэгт болгосон учир журам өөрчлөгдөхөд код хөндөхгүйгээр засагдана.
model ScoringCriterion {
  id          String          @id @default(cuid())
  callId      String
  code        String
  label       String
  description String?
  maxScore    Int
  autoSource  AutoScoreSource @default(NONE)
  /// Автомат бодолтын хуваарь: жишээ нь ЭЕШ-ын дээд оноо 800, голчийн дээд 100.
  autoInputMax Float?
  sortOrder   Int             @default(0)

  call ScholarshipCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, code])
  @@index([callId, sortOrder])
}

/// Бүрдүүлэх материалын жагсаалт. Нүүр хуудас, анкетын хавсралт, комиссын
/// бүрдэл шалгах check-list гурав энэ хүснэгтээс уншина.
model DocumentRequirement {
  id            String  @id @default(cuid())
  callId        String
  code          String
  label         String
  description   String?
  /// Лавлагаа авах гадаад холбоос — жишээ нь e-mongolia-гийн үйлчилгээний хуудас.
  helpUrl       String?
  isRequired    Boolean @default(true)
  allowMultiple Boolean @default(false)
  /// Хавсралт бүрд «Арга хэмжээний нэр» асуух эсэх. Нийгмийн оролцооны
  /// баримт зэрэг арга хэмжээнд холбогдох материалд л хэрэгтэй.
  collectsEventName Boolean @default(false)
  /// Хавсралт бүрд «Тайлбар» асуух эсэх. Лавлагаа шиг нэг утгатай баримтад
  /// тайлбар илүүц тул зөвхөн шаардлагатай газраа асууна.
  collectsNote      Boolean @default(false)
  sortOrder     Int     @default(0)

  call ScholarshipCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, code])
  @@index([callId, sortOrder])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  callId      String
  status      ApplicationStatus @default(DRAFT)
  submittedAt DateTime?

  // Хувийн мэдээлэл — «ТЭТГЭЛЭГ ГОРИЛОГЧИЙН АНКЕТ»-ын 1 дүгээр хэсэг
  /// Эцэг (эх)-ийн нэр (1.3)
  lastName            String?
  /// Өөрийн нэр (1.4)
  firstName           String?
  /// Регистрийн дугаар — АБ12345678
  registerNo          String?
  /// Иргэний бүртгэлийн дугаар — үнэмлэх дээрх 12 оронтой дугаар
  civilRegistrationNo String?
  /// Иргэний харьяалал (1.1)
  citizenship         String?
  /// Ургийн овог (1.2)
  clanName            String?
  birthDate           DateTime?
  gender              Gender?
  /// Үндэс, угсаа (1.7)
  ethnicity           String?
  /// Төрсөн аймаг, хот (1.8)
  birthAimag          String?
  /// Төрсөн сум, дүүрэг (1.8)
  birthSoum           String?

  // Байнгын оршин суугаа хаяг (1.9). `address` нь задаргаанаас нэгтгэгдэж
  // бичигдэнэ — жагсаалт, экспорт зэрэг нэг мөр хаяг хүлээдэг газруудад.
  aimag     String?
  soum      String?
  bag       String?
  khoroolol String?
  street    String?
  unit      String?
  address   String?

  // Холбоо барих (1.10). И-мэйл нь User.email дээр — нэвтрэх нэр нь тэр.
  phone  String?
  phone2 String?

  // Зайлшгүй шаардлага гарсан үед харилцах хүн (1.11)
  contactRelation String?
  contactName     String?
  contactPhone    String?

  // Зорилтот бүлэг (1.12)
  isTargetGroup    Boolean           @default(false)
  targetGroupTypes TargetGroupType[]
  /// «Бусад» сонгосон үеийн тайлбар.
  targetGroupNote  String?

  // Батлан даагч — журмын 2.1 «Батлан даагчтай байх», 5.1/5.2 «Батлан
  // даагчийн хүсэлт». Гэрээний хэрэгжилтэд хамтран хариуцлага хүлээнэ (6.2).
  guarantorName       String?
  guarantorRegisterNo String?
  /// Батлан даагч нь өргөдөгчийн хэн болох (аав, ээж, ах гэх мэт).
  guarantorRelation   String?
  guarantorPhone      String?
  guarantorAddress    String?
  guarantorWorkplace  String?

  // Боловсрол — 12 дугаар анги төгсөгчид
  school         String?
  graduationYear Int?
  examScore      Int?
  gpa            Float?

  // Боловсрол — одоо суралцаж буй оюутнууд
  /// Одоо суралцаж буй курс.
  courseYear    Int?
  /// Их сургуулийн голч дүн, 4.0 систем.
  universityGpa Float?

  // Суралцаж буй их, дээд сургууль, хөтөлбөрийн мэдээлэл (анкетын 2 дугаар хэсэг)
  university    String?
  major         String?
  studyYears    Int?
  tuitionAmount Int?
  /// Магадлан итгэмжлэгдсэн эсэх — сургууль
  isSchoolAccredited  Boolean @default(false)
  /// Магадлан итгэмжлэгдсэн эсэх — хөтөлбөр
  isProgramAccredited Boolean @default(false)

  // Мэргэжил (анкетын 3 дугаар хэсэг)
  isDemandedProfession Boolean @default(false)
  isPriorityProfession Boolean @default(false)
  claimedProfession    String?

  // Эссэ
  essayText      String?
  essayWordCount Int?

  /// «Анкетаа үнэн зөв бичсэн» баталгааг тэмдэглэсэн хугацаа.
  declaredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  call        ScholarshipCall @relation(fields: [callId], references: [id])
  documents   Document[]
  evaluations CriterionEvaluation[]
  decision    Decision?
  emailLogs   EmailLog[]

  @@unique([userId, callId])
  @@index([callId, status])
}

model Document {
  id              String   @id @default(cuid())
  applicationId   String
  requirementCode String
  storageKey      String   @unique
  fileName        String
  mimeType        String
  size            Int
  /// Аль арга хэмжээнд холбогдох баримт болох (олимпиад, тэмцээн гэх мэт).
  eventName       String?
  /// Өргөдөгчийн бичсэн тайлбар. Нэг шаардлагад олон баримт хавсаргах үед
  /// аль нь юу болохыг комисст ойлгуулна.
  note            String?
  uploadedAt      DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model CriterionEvaluation {
  id              String   @id @default(cuid())
  applicationId   String
  criterionCode   String
  reviewerId      String
  
  score           Float?
  status          String?  // "VERIFIED" | "REJECTED"
  comment         String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id])

  // Нэг өргөдөл, нэг шалгуур дээр зөвхөн нэг үнэлгээ байна
  @@unique([applicationId, criterionCode])
  @@index([applicationId])
}

model Decision {
  id            String         @id @default(cuid())
  applicationId String         @unique
  result        DecisionResult
  decidedById   String
  decidedAt     DateTime       @default(now())
  note          String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decidedBy   User        @relation("DecidedBy", fields: [decidedById], references: [id])
}

model EmailLog {
  id            String   @id @default(cuid())
  applicationId String?
  to            String
  template      String
  subject       String
  sentAt        DateTime @default(now())
  status        String
  error         String?

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

/// Хувийн мэдээлэлтэй баримт үзсэн, шийдвэр гаргасан бүх үйлдлийн мөрдөл.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}
