# --- Өгөгдлийн сан ---------------------------------------------------------
# Локал: одоо байгаа PostgreSQL 17 сервис
# Сервер: docker-compose доторх postgres контейнер (host = postgres)
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/burtgel?schema=public"

# --- Апп -------------------------------------------------------------------
APP_URL="http://localhost:3000"

# Сайт HTTPS-гүй (энгийн HTTP) ажиллаж байвал "false" болгоно — эс тэгвээс
# браузер session cookie-г хадгалахгүй тул нэвтэрсэн хэрэглэгч дараагийн
# үйлдэл дээр нэвтрэх хуудас руу буцаагдана. HTTPS дээр гаргах нь зөв шийдэл.
# Хоосон орхивол production-д true, хөгжүүлэлтэд false байна.
COOKIE_SECURE=""

# --- Файл хадгалалт --------------------------------------------------------
# local = ./data/uploads (хөгжүүлэлт), s3 = MinIO (сервер)
STORAGE_DRIVER="local"

# --- И-мэйл ----------------------------------------------------------------
# Хоосон бол и-мэйл илгээгдэхгүй, зөвхөн консоль болон EmailLog-д бичигдэнэ.
# Жишээ: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=""
SMTP_FROM="info@dornogovi.gov.mn"

# --- Админы үйлдэл ---------------------------------------------------------
# Өргөдлийг комиссын жагсаалтаас нуухад асуух нууц үг. Өгөгдөл устдаггүй тул
# буцаан сэргээх боломжтой. Тохируулаагүй бол "ustgah9911".
ADMIN_HIDE_PASSWORD=""

# --- Seed ------------------------------------------------------------------
# Админ, комиссын анхны нууц үг. Тохируулаагүй бол анхдагч утга хэрэглэгдэнэ.
SEED_STAFF_PASSWORD=""

# --- MinIO / S3 (STORAGE_DRIVER=s3 үед) ------------------------------------
# S3_ENDPOINT      апп -> MinIO рүү хандах дотоод хаяг
# S3_PUBLIC_ENDPOINT  браузерт өгөх presigned URL-ийн хаяг
# Хоёулаа заавал. Presigned URL нь хостоо гарын үсэгт оруулдаг тул
# дотоод хаягаар presign хийвэл браузер хандаж чадахгүй.
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="burtgel-docs"
S3_ACCESS_KEY="burtgel-app"
S3_SECRET_KEY="CHANGE_ME"
S3_FORCE_PATH_STYLE="true"

# --- MinIO root (зөвхөн docker-compose-д, апп ашиглахгүй) ------------------
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="CHANGE_ME_TOO"

# --- Postgres (зөвхөн docker-compose-д) ------------------------------------
POSTGRES_USER="burtgel"
POSTGRES_PASSWORD="CHANGE_ME_ALSO"
POSTGRES_DB="burtgel"
